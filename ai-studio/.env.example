# Kopiraj ovu datoteku u .env i popuni. Bez ijednog AI ključa sustav radi u demo načinu.

# ---------- server ----------
# Adresa servera (besplatno na duckdns.org), za HTTPS i za Instagram
DOMAIN=bytecrew.duckdns.org
PUBLIC_BASE_URL=https://bytecrew.duckdns.org
# Lozinka za ploču (obavezno na serveru!)
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=promijeni-me

# ---------- kanal ----------
NICHE=AI tools and tech tips
LANGUAGE=English
TIMEZONE=Europe/Zagreb
# U koliko sati se objavljuje (broj termina = broj videa dnevno)
POST_TIMES=09:00,13:00,18:00
PLATFORMS=youtube,tiktok,instagram
# true = ne pita te za odobrenje tog koraka
AUTO_APPROVE_TOPICS=false
AUTO_APPROVE_PUBLISH=false
# DEMO_MODE=true  # sve simulira, i kad su ključevi upisani

# ---------- AI mozak ----------
# Redoslijed: prvo besplatni, tvoja Claude pretplata tek ako svi zakažu.
# Treba barem jedan ključ (preporuka: Gemini). Bez ijednog sustav radi u demo načinu.
LLM_ORDER=gemini,groq,openrouter,claude_code,claude_api
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324:free

# Tvoja Claude pretplata: na svom računalu pokreni `claude setup-token` i zalijepi token ovdje
CLAUDE_CODE_OAUTH_TOKEN=
CLAUDE_CODE_MODEL=sonnet
# Najviše toliko poziva Claudea dnevno, da ti ostane limita za tebe
CLAUDE_CODE_DAILY_LIMIT=6
# Scenarije dugih videa prvo piše Claude (2-3 tjedno, malo troši)
CLAUDE_FOR_IMPORTANT=true

# Plaćeni Claude API: nije potreban, ostavi prazno
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# ---------- glas i snimke ----------
# Kokoro (besplatno, radi na serveru). Glasovi: am_michael, am_adam, af_heart, af_bella, bm_george...
KOKORO_VOICE=am_michael
KOKORO_SPEED=1.05
# ElevenLabs: nije potreban. Ako upišeš ključ, koristi se umjesto Kokoroa.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# pexels.com/api (besplatno)
PEXELS_API_KEY=

# ---------- dugi YouTube videi (8-12 min) ----------
LONG_ENABLED=true
LONG_DAYS=tue,thu,sat
LONG_TIME=17:00

# ---------- YouTube ----------
# Google Cloud Console -> OAuth client (Web application)
# Redirect URI: https://TVOJA-DOMENA/auth/youtube/callback
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_PRIVACY=public

# ---------- TikTok ----------
# developers.tiktok.com -> tvoja aplikacija (Login Kit + Content Posting API)
# Redirect URI: https://TVOJA-DOMENA/auth/tiktok/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# inbox = skica u TikTok aplikaciji, direct = odmah javno (nakon što TikTok odobri aplikaciju)
TIKTOK_MODE=inbox
TIKTOK_PRIVACY=PUBLIC_TO_EVERYONE

# ---------- Instagram ----------
# Instagram Business/Creator račun povezan s Facebook stranicom, Meta aplikacija
# s dozvolama instagram_basic, instagram_content_publish, instagram_manage_comments
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
