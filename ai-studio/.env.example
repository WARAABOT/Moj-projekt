# Kopiraj ovu datoteku u .env i popuni. Bez ANTHROPIC_API_KEY sustav radi u demo načinu.

# ---------- server ----------
# Domena koja pokazuje na tvoj server (za HTTPS i za Instagram)
DOMAIN=studio.mojadomena.com
PUBLIC_BASE_URL=https://studio.mojadomena.com
# Lozinka za ploču (obavezno na serveru!)
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=promijeni-me

# ---------- kanal ----------
NICHE=AI tools and tech tips
LANGUAGE=English
TIMEZONE=Europe/Zagreb
# U koliko sati se objavljuje (broj termina = broj videa dnevno)
POST_TIMES=09:00,13:00,18:00
PLATFORMS=youtube,tiktok,instagram
# true = ne pita te za odobrenje tog koraka
AUTO_APPROVE_TOPICS=false
AUTO_APPROVE_PUBLISH=false
# DEMO_MODE=true  # sve simulira, i kad su ključevi upisani

# ---------- AI ----------
# console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# elevenlabs.io -> Profile -> API key; ID glasa iz Voice Library
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# pexels.com/api (besplatno)
PEXELS_API_KEY=

# ---------- YouTube ----------
# Google Cloud Console -> OAuth client (Web application)
# Redirect URI: https://TVOJA-DOMENA/auth/youtube/callback
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_PRIVACY=public

# ---------- TikTok ----------
# developers.tiktok.com -> tvoja aplikacija (Login Kit + Content Posting API)
# Redirect URI: https://TVOJA-DOMENA/auth/tiktok/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# inbox = skica u TikTok aplikaciji, direct = odmah javno (nakon što TikTok odobri aplikaciju)
TIKTOK_MODE=inbox
TIKTOK_PRIVACY=PUBLIC_TO_EVERYONE

# ---------- Instagram ----------
# Instagram Business/Creator račun povezan s Facebook stranicom, Meta aplikacija
# s dozvolama instagram_basic, instagram_content_publish, instagram_manage_comments
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
